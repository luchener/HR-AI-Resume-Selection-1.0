# 留空 = 走相对路径（推荐：与前端同源，由 nginx 反代到后端）
# 适用于 https://yourdomain.com 反向代理部署
NEXT_PUBLIC_API_URL=""

# Next.js 同源代理访问的后端地址；与一键启动脚本保持一致。
BACKEND_INTERNAL_URL="http://127.0.0.1:9001"

# 本地开发：浏览器直接连后端 9001
# NEXT_PUBLIC_API_URL="http://127.0.0.1:9001"

# 内网 IP 直连（无反代，但浏览器与后端跨主机）
# NEXT_PUBLIC_API_URL="http://192.168.x.x:9001"

