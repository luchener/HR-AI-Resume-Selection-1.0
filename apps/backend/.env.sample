# ============================================================
# 后端环境变量。使用前复制为 .env：
#   cp .env.sample .env
# ============================================================

# 运行环境：local / production。
# production 下会强制校验 Session/JWT 密钥。
ENV="local"

# 服务端默认 LLM 配置（前端已移除"配置 AI 模型"，分析统一走这里）。
# 部署到生产环境前【必填】DeepSeek API Key。
LLM_API_KEY=""

# OpenAI 兼容 API Base URL 和模型名。默认 DeepSeek，也可换成其他兼容服务。
LLM_BASE_URL="https://api.deepseek.com"
# 推荐 LLM_MODEL；LL_MODEL（历史命名）仍可识别。
LLM_MODEL="deepseek-v4-flash"
# LL_MODEL="deepseek-v4-flash"

# Session 签名密钥。production 下不能是默认值 change-me。
# 生成随机字符串：python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY="change-me"

# JWT 签名密钥（多用户认证）。production 下不能是默认值 change-me-jwt-secret。
# 生成随机字符串：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="change-me-jwt-secret"

# 后端监听端口（本地 run.py 默认读这个；宝塔用 gunicorn 时在面板里设端口）。
BACKEND_PORT=9001

# ---- 以下保持默认即可，无需修改 ----

# 日志目录。默认 apps/backend/logs。
# LOG_DIR="/www/wwwroot/resume-matcher/apps/backend/logs"

# CORS 来源（逗号分隔）。同源反代部署（宝塔/nginx 同域名）留空即可。
# 仅当前端用独立域名/端口访问后端才需要填：
# ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# ---- 忘记密码重置：邮件服务（SMTP）----
# 未配置时"忘记密码"申请返回 503，需管理员配置后才能使用邮件重置。
# 以 QQ 邮箱为例：SMTP_HOST=smtp.qq.com，端口 465（SSL），
# SMTP_PASSWORD 填"授权码"（QQ邮箱 → 设置 → 账户 → 开启SMTP服务生成授权码，不是登录密码）。
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
# 发件人显示地址，留空则默认用 SMTP_USER
# SMTP_FROM=""

# 重置 Token 有效期（秒），默认 30 分钟
# RESET_TOKEN_TTL_SECONDS=1800

# ---- 账号安全：邀请码注册 + 登录防爆破 ----
# 管理员邮箱白名单（逗号分隔可加人）。决定 /api/v1/admin/* 的访问权限与
# 「管理员」标记，也是系统联系邮箱。首个账号必须用白名单邮箱注册（鸡生蛋）。
ADMIN_EMAILS="luchenstudio@163.com"

# 邀请码：长度 4、字母数字混合（不含 0O1lI，不区分大小写）、默认 24h 有效、一次性
# INVITE_CODE_LENGTH=4
# INVITE_CODE_TTL_HOURS=24

# 邀请码申请（申请人公开提交）：理由必填；同一邮箱被拒 ≥3 次后不再接收新申请；
# 每 IP 每日最多 3 条
# INVITE_REQUEST_NOTE_REQUIRED=true
# INVITE_REQUEST_MAX_REJECTIONS=3
# INVITE_REQUEST_MAX_PER_IP_DAY=3

# 登录防爆破：连续失败 ≥3 次进入 5 分钟冷却；10 分钟窗口内累计失败 ≥6 次冻结账号
# （冻结后可用正确密码 + 绑定邮箱验证码自助解冻，或管理员后台解冻）；每 IP 10 分钟
# 内最多 10 次登录失败（防跨用户名撞库）
# LOGIN_FAIL_LIMIT=3
# LOGIN_LOCK_MINUTES=5
# LOGIN_FREEZE_WINDOW_MINUTES=10
# LOGIN_FREEZE_THRESHOLD=6
# LOGIN_MAX_FAIL_PER_IP_10MIN=10
# LOGIN_FREEZE_AUTO_UNFREEZE_HOURS=0   # >0 时冻结超此时长自动解冻（0 = 不自动）

# 数据目录（users / password_resets / invite_requests / invite_codes / login_failures
# / rate_limits 等 JSON 存储的根目录）。默认 apps/backend/data。
# DATA_DIR=""
