FROM python:3.12-slim
WORKDIR /app
COPY apps/backend/requirements.txt apps/backend/requirements-database.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-database.txt
RUN groupadd --gid 1000 appgroup && useradd --uid 1000 --gid 1000 --no-create-home appuser
COPY apps/backend/*.py ./
COPY apps/backend/school_tiers.json ./
COPY apps/backend/tools/ ./tools/
COPY apps/backend/migrations/ ./migrations/
COPY apps/backend/alembic.ini ./
ENV DOTENV_DISABLED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 1000:1000
EXPOSE 8000
CMD ["gunicorn", "-c", "python:gunicorn_sql_preview", "db_deployment:wsgi()"]
