# Refresh the existing private migration runtime with reviewed current sources.
ARG MIGRATION_BASE=resume-db-migration:staging
FROM ${MIGRATION_BASE}
COPY --chown=10001:10001 *.py /app/
COPY --chown=10001:10001 alembic.ini /app/
COPY --chown=10001:10001 migrations/ /app/migrations/
USER 10001:10001
