# Development-only PostgreSQL sandbox. Copy to .env.database, restrict file access,
# and generate FOUR distinct random passwords. Never commit the populated file.
# The official image's superuser name is fixed in Compose: resume_bootstrap_admin.
# Do not put bootstrap credentials in application or migration connection URLs.
POSTGRES_DB=resume_matcher_dev
POSTGRES_LOCAL_PORT=55432
POSTGRES_BOOTSTRAP_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_READONLY_PASSWORD=

# Set connection URLs in the invoking process/secret store when needed; URL-encode
# passwords (do not paste raw passwords containing @, :, /, #, %, etc. into a URL).
# DATABASE_MIGRATION_URL=postgresql+psycopg://resume_migrator:<encoded-password>@127.0.0.1:55432/resume_matcher_dev
# DATABASE_URL=postgresql+psycopg://resume_app:<encoded-password>@127.0.0.1:55432/resume_matcher_dev
# Reporting uses resume_readonly and the reporting schema's allowlisted views only.
